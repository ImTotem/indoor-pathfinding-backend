# DB
DATABASE_URL=postgresql+asyncpg://indoor:indoor@localhost:5432/indoor

# 인증 토큰 (필수 — 실제 운영 시 강력한 랜덤 값으로 교체)
INGEST_API_TOKEN=dev-token

# 파일 저장소 (기본값: server/var/storage)
# STORAGE_ROOT=/path/to/storage

# legacy `/api/slam/v3/localize` DB adapter. Docker compose는 db 값을 주입한다.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=indoor
POSTGRES_USER=indoor
POSTGRES_PASSWORD=indoor

# V1 localize를 실제 SLAM v3 구현에 연결하려면 slam_v3.
# 테스트/문서 스모크는 mock 유지 가능.
INDOOR_VPS_LOCALIZER_MODE=slam_v3

# local macOS 예시. docker image 안에서는 rtabmap-reprocess가 PATH에 있다.
# RTABMAP_PATH=/opt/homebrew/bin/rtabmap-reprocess

# legacy be runtime data root.
DATA_DIR=./be/data

# 업로드 상한 (기본값: 2 GiB)
# MAX_UPLOAD_BYTES=2147483648

# 로그 레벨
LOG_LEVEL=INFO

# ── Sprint 16: Build Phase ─────────────────────────────────────────────────────

# ingest 완료 시 build_job 자동 enqueue 여부 (기본: true)
BUILD_AUTO_ENQUEUE=true

# worker polling 주기 (초, 기본: 2)
BUILD_WORKER_POLL_INTERVAL_SEC=2.0

# running job이 stale로 판단되는 경과 시간 (초, 기본: 600)
BUILD_JOB_STALE_AFTER_SEC=600

# 최대 job 재시도 횟수 (기본: 3)
BUILD_MAX_ATTEMPTS=3

# 모델 캐시 디렉터리 (기본: server/var/models)
# MODEL_CACHE_DIR=/app/var/models

# Walkable grid 셀 크기 (미터, 기본: 0.10)
WALKABLE_GRID_CELL_M=0.10
